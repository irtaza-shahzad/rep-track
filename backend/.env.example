# Docker Compose DB credentials (used by both the db and backend services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password

# For local dev without Docker, point directly at your local Postgres instance
DATABASE_URL=postgresql://postgres:change-me-local-db-password@localhost:5432/workout_tracker
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
