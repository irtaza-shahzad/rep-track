# ============================================
# MONOREPO .gitignore (Backend + Frontend)
# ============================================

# ==========================================
# BACKEND (Python/FastAPI)
# ==========================================

# --- Python Caches & Compiled Files ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
*.manifest
*.spec

# --- Virtual Environment ---
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# --- Database / Alembic ---
alembic/versions/*.pyc
alembic/__pycache__/
*.sqlite3
*.db

# --- Coverage / Test / Reports ---
.coverage
htmlcov/
.tox/
.nox/
pytest_cache/
coverage.xml
*.cover
.cache

# --- Dependency Caches ---
pip-wheel-metadata/
__pypackages__/
dist/
build/

# ==========================================
# FRONTEND (React/Vite/TypeScript)
# ==========================================

# --- Node.js Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build Output ---
dist/
dist-ssr/
*.local

# --- Frontend Logs ---
logs/
*.log

# ==========================================
# SHARED (Both Backend & Frontend)
# ==========================================

# --- Environment & Secrets ---
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- IDE / Editor Settings ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / Temp Files ---
*.bak
*.tmp

# ==========================================
# PROJECT SPECIFIC
# ==========================================

# Test/utility scripts (may contain hardcoded credentials)
backend/test_*.py
backend/check_*.py
backend/trigger_*.py

!*.md
!backend/*.md
!frontend/*.md

design-patterns-analysis.md